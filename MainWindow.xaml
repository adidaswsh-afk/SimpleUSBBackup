<Window x:Class="SimpleUSBBackup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB Backup" Width="490" Height="780" MinWidth="430" MinHeight="660"
        WindowStartupLocation="CenterScreen" Icon="Assets/app-icon.ico"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,25,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="USB Backup" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock Text="Two folders. One simple backup." Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
                </StackPanel>
                <Viewbox Grid.Column="1" Width="55" Height="55" Margin="12,0,0,0" AutomationProperties.Name="USB Backup logo">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="88" Canvas.Top="20" Width="80" Height="65" RadiusX="12" RadiusY="12" Fill="#BDCFDA" />
                        <Rectangle Canvas.Left="104" Canvas.Top="32" Width="12" Height="23" RadiusX="3" RadiusY="3" Fill="#40536B" />
                        <Rectangle Canvas.Left="140" Canvas.Top="32" Width="12" Height="23" RadiusX="3" RadiusY="3" Fill="#40536B" />
                        <Rectangle Canvas.Left="57" Canvas.Top="69" Width="142" Height="168" RadiusX="35" RadiusY="35" Fill="#102C3C" />
                        <Rectangle Canvas.Left="69" Canvas.Top="79" Width="118" Height="137" RadiusX="25" RadiusY="25" Fill="#147D79" />
                        <Path Data="M116 107 H140 V149 H161 L128 181 L95 149 H116Z" Fill="#D2FFF0" />
                        <Rectangle Canvas.Left="97" Canvas.Top="192" Width="62" Height="8" RadiusX="4" RadiusY="4" Fill="#67C9B4" />
                    </Canvas>
                </Viewbox>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SOURCE FOLDERS" Style="{StaticResource Label}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Folder A" FontWeight="SemiBold" />
                            <TextBlock x:Name="FolderAText" Text="Select a folder" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="ChangeAButton" Grid.Column="2" Content="Change" Click="ChangeA_Click" Padding="12,7" FontSize="12" AutomationProperties.Name="Change Folder A" />
                    </Grid>
                    <Border Height="1" Background="#EEF2F4" Margin="0,17" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="Folder B" FontWeight="SemiBold" />
                            <TextBlock x:Name="FolderBText" Text="Select a folder" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="ChangeBButton" Grid.Column="2" Content="Change" Click="ChangeB_Click" Padding="12,7" FontSize="12" AutomationProperties.Name="Change Folder B" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="USB DRIVE" Style="{StaticResource Label}" Margin="0" />
                        <TextBlock x:Name="ConnectionText" Text="●  Not connected" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE88E;" Style="{StaticResource Glyph}" VerticalAlignment="Top" Margin="0,10,0,0" />
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="DrivePicker" DisplayMemberPath="Display" SelectionChanged="DrivePicker_SelectionChanged"
                                      MinHeight="34" Padding="7" HorizontalContentAlignment="Stretch" AutomationProperties.Name="USB drive" />
                            <TextBlock x:Name="DriveDetails" Text="Plug in a USB flash drive" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="1,0,1,20">
                <Grid Margin="0,0,0,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready when you are" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar x:Name="BackupProgressBar" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#DFE9EB" BorderThickness="0" AutomationProperties.Name="Backup progress">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid><Border Background="{TemplateBinding Background}" CornerRadius="4" />
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4" />
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <TextBlock x:Name="ActivityText" Text="Select two source folders to get started." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#AF3838" FontSize="12" Margin="0,7,0,0" Visibility="Collapsed" />
                <Button x:Name="DiagnosticsButton" Content="View diagnostics" Click="Log_Click" HorizontalAlignment="Left" Margin="0,7,0,0" Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="4">
                <Button x:Name="BackupButton" Click="Backup_Click" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Height="47" IsEnabled="False">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="BACKUP TO USB" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                </Button>
                <Button x:Name="EjectButton" Click="Eject_Click" Height="43" Margin="0,10,0,0" IsEnabled="False">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="EJECT USB" FontSize="12" VerticalAlignment="Center" /></StackPanel>
                </Button>
            </StackPanel>
            <Button x:Name="LogButton" Grid.Row="5" Click="Log_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="14,8">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="View Log" FontSize="12" /></StackPanel>
            </Button>
        </Grid>
    </ScrollViewer>
</Window>
